# Pantalk Station - custom bash prompt and shell settings.
# Sourced from /etc/bash.bashrc.d/ so it applies to all interactive shells.

# Prompt: @agent ➜ ~/working/dir (branch) $
# Green username, blue path, cyan parens, red branch, reset dollar.
__pantalk_ps1() {
  local exit_code=$?
  local green='\[\e[0;32m\]'
  local blue='\[\e[1;34m\]'
  local cyan='\[\e[0;36m\]'
  local red='\[\e[1;31m\]'
  local yellow='\[\e[1;33m\]'
  local reset='\[\e[0m\]'

  # Arrow color: green on success, red on failure.
  local arrow
  if [ "$exit_code" -ne 0 ]; then
    arrow='\[\e[1;31m\]➜'
  else
    arrow="${reset}➜"
  fi

  # Git branch (fast, no lock).
  local branch
  branch="$(git --no-optional-locks symbolic-ref --short HEAD 2>/dev/null \
    || git --no-optional-locks rev-parse --short HEAD 2>/dev/null)"

  local git_info=""
  if [ -n "$branch" ]; then
    git_info=" ${cyan}(${red}${branch}${cyan})"
  fi

  PS1="${green}@\\u ${arrow} ${blue}\\w${git_info} ${reset}\$ "
}

PROMPT_COMMAND="__pantalk_ps1"

# Decent defaults.
export EDITOR=vim
export LANG=en_US.UTF-8
export BROWSER=chromium
