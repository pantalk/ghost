# Container images are deliberately pinned for reproducible deployments.
ERGO_IMAGE=ghcr.io/ergochat/ergo:v2.19.0
THELOUNGE_IMAGE=ghcr.io/thelounge/thelounge:4.5.2
STATION_IMAGE=ghcr.io/pantalk/station:0.0.5
STATION_PLATFORM=linux/amd64

# Local Station build arguments used by compose.dev.yaml.
PANTALK_VERSION=0.0.10

# Local browser and IRC endpoints.
ERGO_BIND_ADDRESS=127.0.0.1
ERGO_PORT=6667
THELOUNGE_BIND_ADDRESS=127.0.0.1
THELOUNGE_PORT=9000
STATION_BIND_ADDRESS=127.0.0.1
STATION_PORT=6902
STATION_RESOLUTION=1920x1080

# The IRC channel joined by the browser client and both Pantalk bots.
IRC_CHANNEL=#station
