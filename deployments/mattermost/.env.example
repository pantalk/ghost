# Container images are deliberately pinned for reproducible deployments.
POSTGRES_IMAGE=postgres:18.2-alpine
MATTERMOST_IMAGE=mattermost/mattermost-team-edition:11.7.0
GHOST_IMAGE=ghcr.io/pantalk/ghost:0.0.8

# Local build arguments used by compose.dev.yaml.
PANTALK_VERSION=0.0.12

# Browser endpoints. Ghost must remain bound to a trusted interface because
# its KasmVNC desktop does not require a browser password.
MATTERMOST_BIND_ADDRESS=127.0.0.1
MATTERMOST_PORT=8065
MATTERMOST_SITE_URL=http://127.0.0.1:8065
GHOST_BIND_ADDRESS=127.0.0.1
GHOST_PORT=6902
DESKTOP_RESOLUTION=1920x1080

# Provisioned Mattermost resources.
MATTERMOST_ADMIN_USERNAME=operator
MATTERMOST_ADMIN_EMAIL=operator@pantalk.local
MATTERMOST_ADMIN_PASSWORD=replace-with-a-strong-password
MATTERMOST_TEAM=pantalk
MATTERMOST_CHANNEL=agents

# PostgreSQL credentials. Keep the password URL-safe because Mattermost uses it
# inside MM_SQLSETTINGS_DATASOURCE.
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=replace-with-a-url-safe-password
POSTGRES_DB=mattermost
