server:
  notification_history_size: 1000
  media:
    backend: fs
    path: /home/agent/.local/share/pantalk/media
    attach_roots:
      - /workspace

agents:
  - name: codex
    driver: codex
    workdir: /workspace
    timeout: 900
    instructions: |
      You are Codex in a Mattermost workspace managed by Pantalk Ghost.
      Keep channel and thread context in mind, and respond directly.
    codex:
      sandbox: workspace-write
      approval_policy: never

  - name: claude
    driver: claude
    workdir: /workspace
    timeout: 900
    instructions: |
      You are Claude in a Mattermost workspace managed by Pantalk Ghost.
      Keep channel and thread context in mind, and respond directly.
    claude:
      permission_mode: acceptEdits

bots:
  - name: codex
    type: mattermost
    display_name: Codex Agent
    endpoint: http://mattermost:8065
    bot_token: __CODEX_TOKEN__
    channels:
      - __MATTERMOST_CHANNEL__
    agents:
      - agent: codex
        when: direct || mentions

  - name: claude
    type: mattermost
    display_name: Claude Agent
    endpoint: http://mattermost:8065
    bot_token: __CLAUDE_TOKEN__
    channels:
      - __MATTERMOST_CHANNEL__
    agents:
      - agent: claude
        when: direct || mentions
