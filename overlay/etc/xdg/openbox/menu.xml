<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Pantalk Ghost">
    <item label="Welcome">
      <action name="Execute">
        <command>desktop-welcome</command>
      </action>
    </item>
    <separator />
    <item label="Terminal">
      <action name="Execute">
        <command>kitty</command>
      </action>
    </item>
    <separator />
    <item label="File Manager">
      <action name="Execute">
        <command>kitty -e ranger /workspace</command>
      </action>
    </item>
    <item label="Task Manager">
      <action name="Execute">
        <command>kitty -e htop</command>
      </action>
    </item>
    <separator />
    <item label="Browser">
      <action name="Execute">
        <command>chromium file:///opt/browser/index.html</command>
      </action>
    </item>
    <separator />
    <menu id="setup-menu" label="Setup">
      <item label="Sign in to Codex...">
        <action name="Execute">
          <command>kitty --title "Codex Login" -e bash -lc "CODEX_LOGIN_DEFAULT=device agent-runtime-login codex; exec bash"</command>
        </action>
      </item>
      <item label="Sign in to Claude Code...">
        <action name="Execute">
          <command>kitty --title "Claude Login" -e bash -lc "agent-runtime-login claude; exec bash"</command>
        </action>
      </item>
      <item label="Sign in to Kimi Code...">
        <action name="Execute">
          <command>kitty --title "Kimi Login" -e bash -lc "agent-runtime-login kimi; exec bash"</command>
        </action>
      </item>
      <separator />
      <item label="Codex Status">
        <action name="Execute">
          <command>kitty --title "Codex Status" -e bash -lc "codex login status; exec bash"</command>
        </action>
      </item>
      <item label="Claude Status">
        <action name="Execute">
          <command>kitty --title "Claude Status" -e bash -lc "claude auth status; exec bash"</command>
        </action>
      </item>
    </menu>
    <menu id="logs-menu" label="Logs">
      <item label="Pantalk Daemon Log">
        <action name="Execute">
          <command>kitty --title "Pantalk Daemon Log" -e bash -lc "tail --lines=200 --follow /var/log/launcher-desktop/pantalkd.log"</command>
        </action>
      </item>
      <item label="Ghost Log Directory">
        <action name="Execute">
          <command>kitty -e ranger /var/log/launcher-desktop</command>
        </action>
      </item>
    </menu>
    <separator />
    <menu id="tiling-menu" label="Tiling Mode">
      <item label="Enable Tiling">
        <action name="Execute">
          <command>cortilectl on</command>
        </action>
      </item>
      <item label="Disable Tiling (Floating)">
        <action name="Execute">
          <command>cortilectl off</command>
        </action>
      </item>
      <item label="Toggle Tiling">
        <action name="Execute">
          <command>cortilectl toggle</command>
        </action>
      </item>
      <separator />
      <item label="Next Layout">
        <action name="Execute">
          <command>cortilectl next-layout</command>
        </action>
      </item>
      <item label="Previous Layout">
        <action name="Execute">
          <command>cortilectl prev-layout</command>
        </action>
      </item>
      <separator />
      <item label="Stop Tiling Helper">
        <action name="Execute">
          <command>cortilectl stop</command>
        </action>
      </item>
      <item label="Start Tiling Helper">
        <action name="Execute">
          <command>cortilectl start</command>
        </action>
      </item>
    </menu>
  </menu>
</openbox_menu>
