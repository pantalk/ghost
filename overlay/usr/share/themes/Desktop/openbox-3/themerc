### WINDOW
border.width: 1

# Preserve the shared desktop's generous resize target while replacing the
# generic black frame with Pantalk's page background.
window.client.padding.width: 6
window.client.padding.height: 6
window.handle.width: 0

padding.width: 6
padding.height: 5

window.active.border.color: #24DBC9
window.inactive.border.color: #080A0C
window.active.title.separator.color: #282E33
window.inactive.title.separator.color: #202427
window.active.client.color: #080A0C
window.inactive.client.color: #080A0C

window.active.label.text.color: #FFFFFF
window.inactive.label.text.color: #818C98

window.active.button.unpressed.image.color: #FFFFFF
window.active.button.pressed.image.color: #24DBC9
window.active.button.disabled.image.color: #282E33
window.active.button.hover.image.color: #50E2D4
window.active.button.toggled.unpressed.image.color: #FFFFFF
window.active.button.toggled.pressed.image.color: #24DBC9
window.active.button.toggled.hover.image.color: #50E2D4
window.inactive.button.unpressed.image.color: #818C98
window.inactive.button.pressed.image.color: #24DBC9
window.inactive.button.disabled.image.color: #282E33
window.inactive.button.hover.image.color: #50E2D4
window.inactive.button.toggled.unpressed.image.color: #818C98
window.inactive.button.toggled.pressed.image.color: #24DBC9
window.inactive.button.toggled.hover.image.color: #50E2D4

window.active.title.bg: flat solid
window.active.title.bg.color: #151A1E
window.active.label.bg: flat solid
window.active.label.bg.color: #151A1E
window.active.handle.bg: flat solid
window.active.handle.bg.color: #151A1E
window.active.grip.bg: flat solid
window.active.grip.bg.color: #151A1E
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #0F1215
window.inactive.label.bg: flat solid
window.inactive.label.bg.color: #0F1215
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #0F1215
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #0F1215

window.active.button.unpressed.bg: parentrelative
window.active.button.pressed.bg: parentrelative
window.active.button.hover.bg: parentrelative
window.active.button.disabled.bg: parentrelative
window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.pressed.bg: parentrelative
window.active.button.toggled.hover.bg: parentrelative
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.pressed.bg: parentrelative
window.inactive.button.hover.bg: parentrelative
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.pressed.bg: parentrelative
window.inactive.button.toggled.hover.bg: parentrelative

window.label.text.justify: center

#window.active.label.text.font: text shadow
#window.inactive.label.text.font: text shadow

### MENU
menu.border.width: 1
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 4

menu.overlap.x: 0
menu.overlap.y: 0

menu.border.color: #24DBC9
menu.separator.color: #282E33

menu.title.text.color: #FFFFFF
menu.items.text.color: #818C98
menu.items.disabled.text.color: #282E33
menu.items.active.text.color: #080A0C
menu.items.active.disabled.text.color: #202427

menu.items.bg: flat solid
menu.items.bg.color: #080A0C
menu.items.active.bg: flat solid
menu.items.active.bg.color: #24DBC9
menu.title.bg: flat solid
menu.title.bg.color: #0F1215

menu.title.text.justify: center

#menu.items.font: text shadow
#menu.title.text.font: text shadow

### OSD
osd.border.width: 1

osd.border.color: #282E33

osd.label.text.color: #FFFFFF

osd.bg: flat solid
osd.bg.color: #080A0C
osd.label.bg: flat solid
osd.label.bg.color: #080A0C
osd.hilight.bg: flat solid
osd.hilight.bg.color: #24DBC9
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #151A1E

#osd.label.text.font: text shadow
