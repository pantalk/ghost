#!/bin/bash
# desktop-harness - open the selected agent harness in a terminal.
#
# Bound to Control-Shift-G by the desktop base. The KasmVNC mascot synthesises
# the same chord, so both paths run this one command.
#
# There is no separate "pick your harness" UI: agent-runtime-login records the
# runtime whenever a sign-in flow completes, so signing in to a harness is what
# makes it the default.  Until that happens the fallback below is used.
#
# Both entry points run this same script - the Openbox W-g binding and the
# desktop mascot in the KasmVNC client, which synthesises that chord.

set -euo pipefail

state_dir="${GHOST_HARNESS_STATE_DIR:-$HOME/.config/pantalk-ghost}"
state_file="$state_dir/harness"
fallback="${GHOST_HARNESS_DEFAULT:-codex}"
terminal="${GHOST_HARNESS_TERMINAL:-kitty}"

# A harness acts on the directory it starts in. Openbox inherits the session's
# home directory and passes it to anything it launches, so without this the
# desktop would open a harness pointed at $HOME while the same harness reached
# through chat works in /workspace, per workdir: in the Pantalk config.
workdir="${GHOST_HARNESS_WORKDIR:-/workspace}"

usage() {
    cat <<'EOF'
Open the selected agent harness

Usage:
  desktop-harness [--dry-run]

The harness is whichever runtime last completed a sign-in flow through
agent-runtime-login. With --dry-run, print the resolved harness, its command,
and its window title instead of opening anything.

Environment:
  GHOST_HARNESS_DEFAULT     harness to use when nothing has been selected yet
  GHOST_HARNESS_STATE_DIR   directory holding the selection (default:
                            $HOME/.config/pantalk-ghost)
  GHOST_HARNESS_TERMINAL    terminal emulator to launch (default: kitty)
  GHOST_HARNESS_WORKDIR     directory the harness starts in (default:
                            /workspace, matching the Pantalk agent workdir)
EOF
}

is_known_harness() {
    case "${1:-}" in
        codex | claude | kimi) return 0 ;;
        *) return 1 ;;
    esac
}

harness_title() {
    case "$1" in
        codex) printf 'Codex Harness\n' ;;
        claude) printf 'Claude Harness\n' ;;
        kimi) printf 'Kimi Harness\n' ;;
    esac
}

harness_binary() {
    case "$1" in
        codex) printf '%s\n' "${CODEX_COMMAND:-codex}" ;;
        claude) printf '%s\n' "${CLAUDE_COMMAND:-claude}" ;;
        kimi) printf '%s\n' "${KIMI_COMMAND:-kimi}" ;;
    esac
}

# Selection first, then the configured fallback, then codex. A selection file
# left over from an older image can name something unknown, so it is validated
# rather than trusted.
resolve_harness() {
    local selected=""

    if [ -r "$state_file" ]; then
        selected="$(head -n 1 "$state_file" | tr -d '[:space:]')"
    fi

    if ! is_known_harness "$selected"; then
        selected="$fallback"
    fi

    if ! is_known_harness "$selected"; then
        selected="codex"
    fi

    printf '%s\n' "$selected"
}

dry_run=0
case "${1:-}" in
    --dry-run)
        dry_run=1
        ;;
    help | -h | --help)
        usage
        exit 0
        ;;
    "") ;;
    *)
        printf 'Unknown argument: %s\n' "$1" >&2
        usage >&2
        exit 1
        ;;
esac

harness="$(resolve_harness)"
title="$(harness_title "$harness")"
binary="$(harness_binary "$harness")"

if [ "$dry_run" -eq 1 ]; then
    printf '%s %s %s %s\n' "$harness" "$binary" "$title" "$workdir"
    exit 0
fi

# Fall back to wherever we already are rather than refusing to open a harness,
# in case the workspace volume is missing.
if [ -d "$workdir" ]; then
    cd "$workdir"
fi

# The mascot is a click target, so repeated clicks are expected. Raise the
# existing window instead of stacking terminals.
if command -v wmctrl >/dev/null 2>&1 && wmctrl -l 2>/dev/null |
    grep -Fq -- "$title"; then
    wmctrl -a "$title"
    exit 0
fi

exec "$terminal" --title "$title" -e bash -lc "$binary; exec bash"
