#!/bin/bash
# pantalk-greeting - first-launch greeting for the Pantalk Ghost terminal.
#
# Printed by desktop-welcome, which owns the terminal and the shell that
# follows it. This only writes the greeting.
# Displays ASCII art, then drops into an interactive shell.
# Only invoked from autostart; subsequent terminals skip this.

clear

# ANSI color codes (using $'...' so \e is interpreted).
C=$'\e[38;2;36;219;201m'
D=$'\e[38;2;129;140;152m'
B=$'\e[1m'
R=$'\e[0m'

cat <<EOF

${C}░       ░░░░      ░░░   ░░░  ░░        ░░░      ░░░  ░░░░░░░░  ░░░░  ░${R}
${C}▒  ▒▒▒▒  ▒▒  ▒▒▒▒  ▒▒    ▒▒  ▒▒▒▒▒  ▒▒▒▒▒  ▒▒▒▒  ▒▒  ▒▒▒▒▒▒▒▒  ▒▒▒  ▒▒${R}
${C}▓       ▓▓▓  ▓▓▓▓  ▓▓  ▓  ▓  ▓▓▓▓▓  ▓▓▓▓▓  ▓▓▓▓  ▓▓  ▓▓▓▓▓▓▓▓     ▓▓▓▓${R}
${C}█  ████████        ██  ██    █████  █████        ██  ████████  ███  ██${R}
${C}█  ████████  ████  ██  ███   █████  █████  ████  ██        ██  ████  █${R}
                                                                      
${D}──────────────────────────────────────────────────────────────────────${R}
${B}Pantalk Ghost${R}
${D}──────────────────────────────────────────────────────────────────────${R}

${B}    GET STARTED${R}
${D}    1. Right-click the desktop and open Setup.
       Sign in to Codex, Claude Code, or Kimi Code.
    2. Start a deployment recipe or configure a messaging connector.
    3. Message the configured agent from that provider's chat client.

    Ctrl+Shift+G opens the harness you last signed in to, as does clicking
    the ghost in the lower-left corner.
    Ctrl+Shift+T toggles tiling. File Manager opens /workspace.
    In Ranger, press 'W for Workspace or 'H for Home.${R}

EOF
