#!/bin/bash
# Openbox autostart - runs when the desktop session begins.

set -e

# Register chromium wrapper as the default browser if MIME associations
# are not already configured (init.sh handles this for rootfs; this fallback
# covers standalone Docker mode).
if [ ! -f "$HOME/.config/mimeapps.list" ]; then
  mkdir -p "$HOME/.local/share/applications" "$HOME/.config"
  cat > "$HOME/.local/share/applications/chromium-ghost.desktop" <<'CHROMEDESKTOP'
[Desktop Entry]
Name=Chrome
Exec=chromium %u
Type=Application
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/html;
NoDisplay=true
CHROMEDESKTOP
  cat > "$HOME/.config/mimeapps.list" <<'MIMEAPPS'
[Default Applications]
x-scheme-handler/http=chromium-ghost.desktop
x-scheme-handler/https=chromium-ghost.desktop
text/html=chromium-ghost.desktop
MIMEAPPS
  xdg-settings set default-web-browser chromium-ghost.desktop 2>/dev/null || true
fi
export BROWSER=chromium

# Make kitty open detected URLs with a simple click and delegate to xdg-open.
#
# @note The rendering block matters more than it looks.  Kitty is an OpenGL
# terminal and this desktop has no GPU, so every repaint is llvmpipe work that
# KasmVNC then has to re-encode into a frame.  A blinking cursor on its own
# produced 17 screen changes in 12 seconds on an otherwise idle terminal;
# disabling the blink and slowing the repaint clock takes that to zero.
mkdir -p "$HOME/.config/kitty"
cat > "$HOME/.config/kitty/kitty.conf" <<'KITTYCONF'
detect_urls yes
open_url_with chromium
url_color #5599ff
cursor_shape block
shell_integration no-cursor
confirm_os_window_close 0
map ctrl+c copy_or_interrupt
map ctrl+v paste_from_clipboard
window_padding_width 8

# Rendering - tuned for a software-rendered remote display.
repaint_delay 40
input_delay 8
sync_to_monitor no
cursor_blink_interval 0
mouse_hide_wait 0
disable_ligatures always
resize_debounce_time 0.1
KITTYCONF

# Use the Pantalk-branded wallpaper on every launch. Remove the former
# random-wallpaper state file when upgrading an existing Ghost home.
wallpaper="/usr/share/backgrounds/pantalk-ghost.svg"
rm -f "$HOME/.wallpaper"

# Wallpaper watcher - KasmVNC resizes the display when the browser
# connects, which invalidates any root pixmap set earlier.  This loop
# detects resolution changes and re-applies the wallpaper so it is
# always scaled to fill the screen instead of being tiled.
if [ -f "$wallpaper" ]; then
  rm -f "$HOME/.fehbg"
  (
    last_res=""
    while true; do
      cur_res="$(xdpyinfo -display "${DISPLAY:-:1}" 2>/dev/null \
        | awk '/dimensions/{print $2}')"
      if [ -n "$cur_res" ] && [ "$cur_res" != "$last_res" ]; then
        feh --no-fehbg --bg-fill "$wallpaper"
        last_res="$cur_res"
      fi
      sleep 2
    done
  ) &
fi

# The image owns the panel layout. Load it explicitly so Tint2 does not prefer
# a stale tint2rc copied into the user config on an earlier run.
tint2 -c /etc/xdg/tint2/tint2rc &

# Start Cortile so tiling can be toggled on-demand.
# Floating mode remains default because tiling_enabled=false in Cortile config.
cortilectl start &

# Open a terminal window on startup with a welcome greeting.
kitty \
  --title "Pantalk Ghost" \
  --override remember_window_size=no \
  --override initial_window_width=100c \
  --override initial_window_height=34c \
  -e /usr/local/bin/welcome &
